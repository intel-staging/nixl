# NIXL XPU Test Environment
#
# Intel XPU (Level Zero) testing container with UCX built against the
# oneAPI Level Zero stack. Used by the xpu-ci workflow.
#
# Usage:
#   docker build -f .ci/dockerfiles/Dockerfile.xpu -t nixl-xpu .
#

ARG BASE_IMAGE=intel/oneapi-toolkit:2026.0.0-devel-ubuntu24.04

FROM ${BASE_IMAGE}

# UCX is pinned to a specific master commit because Intel XPU (Level Zero)
# features required by the XPU backend have not yet landed in a UCX release.
# When a UCX release ships with the required ZE features, switch to a
# release tag and drop UCX_COMMIT. Bump deliberately; do not float on master.
ARG UCX_REPO_URL=https://github.com/openucx/ucx.git
ARG UCX_COMMIT=36333b9b1f263c82b2893fc8f05ad1596f325237
ARG UCX_SRC_DIR=/tmp/ucx_source
ARG UCX_INSTALL_DIR=/usr
ARG WORKSPACE=/workspace/nixl
ARG XPU_SMI_DEB_URL=https://github.com/intel/xpumanager/releases/download/v1.3.6/xpu-smi_1.3.6_20260206.143628.1004f6cb.u24.04_amd64.deb
ARG XPU_SMI_DEB_SHA256=f60e802b6f41350393e34b24793db888a8be514054769bd17e7a6e9c0c058b87

# Labels for documentation
LABEL maintainer="NVIDIA NIXL Team"
LABEL description="Intel XPU (Level Zero) test environment for NIXL development"
LABEL version="1.0"

# The base image ships with the oneAPI apt source configured, but oneAPI is
# already installed. Remove it to avoid unnecessary network hits that can
# cause apt-get update to fail when apt.repos.intel.com is unreachable.
RUN rm -f /etc/apt/sources.list.d/*oneapi*.list \
          /etc/apt/sources.list.d/*oneAPI*.list

# Install build/runtime dependencies.
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends \
        python3.12-dev \
        python3-pip \
        autoconf \
        automake \
        libtool \
        m4 \
        libcjson-dev \
        linux-libc-dev \
        libaio-dev \
        librdmacm-dev \
        librdmacm1 \
        ibverbs-utils \
        libibverbs-dev \
        libibverbs1 \
        rdma-core \
        numactl \
        libgtest-dev && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.12 100 && \
    python3 -m pip config set global.break-system-packages true && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install xpu-smi from the upstream .deb release.
# Kept separate so a release URL change does not invalidate the apt cache layer.
RUN wget -O /tmp/xpu-smi.deb ${XPU_SMI_DEB_URL} && \
    echo "${XPU_SMI_DEB_SHA256}  /tmp/xpu-smi.deb" | sha256sum -c - && \
    apt-get update -y && \
    apt-get install -y --no-install-recommends /tmp/xpu-smi.deb && \
    rm -f /tmp/xpu-smi.deb && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Build and install UCX from pinned commit.
# Source is removed in the same RUN to avoid bloating the image layer.
RUN git clone ${UCX_REPO_URL} ${UCX_SRC_DIR} && \
    cd ${UCX_SRC_DIR} && \
    git checkout ${UCX_COMMIT} && \
    ./autogen.sh && \
    ./configure \
        --prefix=${UCX_INSTALL_DIR} \
        --with-ze=yes \
        --enable-examples \
        --enable-shared \
        --disable-static \
        --disable-doxygen-doc \
        --enable-optimizations \
        --enable-cma \
        --enable-mt \
        --with-verbs \
        --with-rdmacm && \
    make -j$(nproc) && \
    make -j install-strip && \
    ldconfig && \
    rm -rf ${UCX_SRC_DIR}

# Set working directory
WORKDIR ${WORKSPACE}
COPY . .

# Build and install NIXL.
# GDS backend is disabled because it is NVIDIA-specific.
RUN set -eux; \
    pip install --no-cache-dir meson ninja pybind11; \
    meson setup build -Dinstall_headers=true -Ddisable_gds_backend=true; \
    cd build; \
    ninja; \
    ninja install; \
    test -f /opt/nvidia/nvda_nixl/lib/x86_64-linux-gnu/libnixl.so

# Library and Python paths for NIXL.
ENV LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+${LD_LIBRARY_PATH}:}/opt/nvidia/nvda_nixl/lib/x86_64-linux-gnu"
ENV PYTHONPATH="${PYTHONPATH:+${PYTHONPATH}:}/opt/nvidia/nvda_nixl/lib/python3/dist-packages"

ENTRYPOINT ["/bin/bash", "-c", "exec \"$@\"", "--"]

# Default command
CMD ["/bin/bash"]
